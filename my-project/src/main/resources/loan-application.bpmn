  <bpmn:process id="loan-application" name="Loan Application" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Loan Application Received">
      <bpmn:outgoing>Flow_02igf9r</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_02igf9r" sourceRef="StartEvent_1" targetRef="loan-variables" />
    <bpmn:serviceTask id="loan-variables" name="Loan Variables" camunda:class="com.guru.camunda.delegate.LoanVariablesDelegate">
      <bpmn:incoming>Flow_02igf9r</bpmn:incoming>
      <bpmn:outgoing>Flow_0vqgi15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="approval-gateway" name="ApprovalGateway">
      <bpmn:incoming>Flow_0vqgi15</bpmn:incoming>
      <bpmn:outgoing>Flow_06gozz1</bpmn:outgoing>
      <bpmn:outgoing>Flow_0so4ukd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0vqgi15" sourceRef="loan-variables" targetRef="approval-gateway" />
    <bpmn:serviceTask id="reject-loan" name="Reject Loan" camunda:class="com.guru.camunda.delegate.RejectLoanDelegate">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_06gozz1</bpmn:incoming>
      <bpmn:outgoing>Flow_1cz54zs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_06gozz1" name="No" sourceRef="approval-gateway" targetRef="reject-loan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="approve-loan" name="Approve Loan" camunda:class="com.guru.camunda.delegate.ApproveLoanDelegate">
      <bpmn:incoming>Flow_0so4ukd</bpmn:incoming>
      <bpmn:outgoing>Flow_1238kkg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0so4ukd" name="Yes" sourceRef="approval-gateway" targetRef="approve-loan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="application-approved" name="Loan Application Approved">
      <bpmn:incoming>Flow_1238kkg</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1238kkg" sourceRef="approve-loan" targetRef="application-approved" />
    <bpmn:endEvent id="application-rejected" name="Loan Application Rejected">
      <bpmn:incoming>Flow_1cz54zs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1cz54zs" sourceRef="reject-loan" targetRef="application-rejected" />
  </bpmn:process>
